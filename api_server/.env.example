# Copy this file to .env and adjust values as needed.
# The system loads these as environment variables prior to starting the app.

# Database provider: "sqlite" (default) or "inmemory"
DB_PROVIDER=sqlite

# For sqlite, override the default path if desired; example:
# DB_CONNECTION_STRING="Data Source=/data/products.db"

# CORS: optionally specify allowed origins (comma separated). If not set, AllowAll is used for development.
# ALLOWED_ORIGINS=http://localhost:3000,https://example.com
